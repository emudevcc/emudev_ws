# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Email (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=esteban@emudev.com
ADMIN_EMAIL=esteban.montero@gmail.com

# Site
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_DOMAIN=emudev.cc

# Cloudflare (CI only)
CF_API_TOKEN=
CF_ZONE_ID=

# Vercel (CI only)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# OpenAI (optional AI review)
OPENAI_API_KEY=

# Google Gemini chat widget (server-side only)
GEMINI_API_KEY=

# Google Cloud TTS WaveNet (server-side only)
GOOGLE_TTS_API_KEY=

# Exact origin allowed to call /api/chat, no trailing slash.
# Supports comma-separated origins for apex + www.
# Example: https://emudev.cc,https://www.emudev.cc
CHAT_ALLOWED_ORIGIN=

# Optional deployed assistant profile. If unset, the server reads data/profile.md
# locally and falls back to tracked data/profile-template.md in production.
CHAT_PROFILE_MARKDOWN=
