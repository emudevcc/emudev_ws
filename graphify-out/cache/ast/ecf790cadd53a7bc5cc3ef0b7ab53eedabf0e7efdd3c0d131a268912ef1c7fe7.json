      "caller_nid": "lib_sanity_queries_getprojectbyslug",
      "callee": "unstable_cache(\n    async () =>\n      sanityFetch<{\n        _id: string\n        title: string\n        slug: { current: string }\n        description: string\n        featuredImage: string\n        content: unknown[]\n        tags: Array<{ _id: string; title: string }>\n        liveUrl: string\n        repoUrl: string\n        publishedAt: string\n        _createdAt: string\n      } | null>({\n        query: groq`*[_type == \"project\" && slug.current == $slug][0] {\n          ...,\n          \"featuredImage\": featuredImage.asset->url,\n          tags[]->{ _id, title }\n        }`,\n        params: { slug },\n      }),\n    [`project-${slug}`],\n    { tags: ['projects', `project:${slug}`], revalidate: 3600 }\n  )",
      "is_member_call": false,
