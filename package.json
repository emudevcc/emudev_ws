{
  "name": "emudev-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names \"next,tokens\" \"next dev --turbopack\" \"tsx --watch scripts/generate-css-tokens.ts\"",
    "generate:tokens": "tsx scripts/generate-css-tokens.ts",
    "build": "npm run generate:tokens && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sanity:dev": "sanity dev",
    "sanity:types": "sanity schema extract && sanity typegen generate && mv -f sanity.types.ts types/sanity.types.ts",
    "supabase:types": "supabase gen types typescript --linked > types/supabase.types.ts",
    "supabase:push": "supabase db push",
    "test:smoke": "playwright test tests/smoke/",
    "test:smoke:local": "BASE_URL=http://localhost:3000 playwright test tests/smoke/",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@portabletext/react": "^6.2.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^3.99.0",
    "@sanity/visual-editing": "^4.0.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "@types/three": "^0.184.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "15.5.18",
    "next-intl": "^4.11.1",
    "next-sanity": "^5.5.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.3",
    "sanity": "^3.99.0",
    "styled-components": "^6.4.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "@sanity/codegen": "^6.0.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
